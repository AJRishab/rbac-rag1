# Sentry RAG — Backend environment
# Copy this file to `.env` before running the backend:
#   cp .env.example .env   (then fill in real values)
#
# The backend loads backend/.env on import (see database.py / nim_client.py).

# ---------------------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------------------

# Postgres connection string. Use postgresql+asyncpg://. For Supabase, grab the
# URI and switch the scheme (see DEPLOY_HF_SUPABASE.md). URL-encode the password
# if it contains special characters.
DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# NVIDIA NIM API key (for embeddings + chat).
NIM_API_KEY=your_nvidia_nim_api_key

# Supabase project URL — the backend fetches the JWKS signing key from
# {SUPABASE_URL}/auth/v1/.well-known/jwks.json to verify ES256 JWTs.
SUPABASE_URL=https://your-project-ref.supabase.co

# ---------------------------------------------------------------------------
# OPTIONAL (safe defaults are used when omitted)
# ---------------------------------------------------------------------------

# Comma-separated origins allowed to call the /api. Default: Vercel frontend.
CORS_ORIGINS=https://rbac-rag-nine.vercel.app

# NVIDIA NIM endpoint + model overrides.
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# Nemotron-3 Embed outputs 2048-dimensional vectors. This must match the
# `chunks.embedding vector(2048)` database column.
NIM_EMBED_MODEL=nvidia/nemotron-3-embed-1b
# Llama 3.1 8B reached NVIDIA API end of life on 2026-08-26.
NIM_CHAT_MODEL=meta/llama-3.3-70b-instruct
# Cross-encoder reranker model (NIM /v1/ranking endpoint).
# The old nv-rerankqa-mistral-4b-v3 default is DEPRECATED and rerank models are in
# heavy churn. Verify an available ID for YOUR key first:
#   curl -s https://integrate.api.nvidia.com/v1/models -H "Authorization: Bearer $NIM_API_KEY" \
#     | python3 -m json.tool | grep rerank
# candidate IDs seen historically: nvidia/llama-3.2-nv-rerankqa-1b-v2,
# Reranker model (verified live on 2026-08-19): nv-rerank-qa-mistral-4b:1
# (short name + ":1" version suffix). The previous long-form
# nvidia/nv-rerankqa-mistral-4b-v3 is deprecated and returned 404s. The cloud
# API actually serves this model at ai.api.nvidia.com, NOT integrate.api.nvidia.com.
NIM_RERANK_MODEL=nvidia/llama-nemotron-rerank-1b-v2

# Base HOST of the reranker endpoint. The client appends the canonical route
# /v1/retrieval/nvidia/reranking (de-duplicated), so set the host only — or the
# full endpoint URL; both are accepted. The reranker is on a DIFFERENT host
# (ai.api.nvidia.com) than NIM_BASE_URL (integrate.api.nvidia.com); it is NOT
# derived from NIM_BASE_URL.
NIM_RERANK_BASE_URL=https://ai.api.nvidia.com

# Run a one-shot reranker health probe at startup (default true). Set false to skip.
RERANK_PROBE_ON_STARTUP=true

# Max prompt size (per chunk, in characters) for the AI-role-suggestion call.
NIM_CHUNK_ROLE_BATCH_CHARS=24000

# Path to the built React SPA (only needed when serving the frontend from the
# backend, e.g. the Docker Space). Leave empty for API-only.
FRONTEND_BUILD_DIR=

# ---------------------------------------------------------------------------
# NOTES
# ---------------------------------------------------------------------------
# - No DATABASE_SSL variable is read by the code: asyncpg enables TLS
#   automatically for *.supabase.co hosts.
# - Supabase signup/login happen client-side; there is NO backend /register or
#   /login, and no JWT_SECRET / ADMIN_EMAIL / ADMIN_PASSWORD contract anymore.
