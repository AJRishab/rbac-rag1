# Sentry RAG - Backend environment
# Copy this file to `.env` before running the backend:
#   cp .env.example .env   (then fill in real values)
#
# The backend loads backend/.env on import (see database.py / openrouter.py).

# ---------------------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------------------

# Postgres connection string. Use postgresql+asyncpg://. For Supabase, grab the
# URI and switch the scheme. URL-encode the password if it contains special chars.
DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# OpenRouter API key (embeddings + chat + rerank) - https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key

# Supabase project URL - the backend fetches the JWKS signing key from
# {SUPABASE_URL}/auth/v1/.well-known/jwks.json to verify ES256 JWTs.
SUPABASE_URL=https://your-project-ref.supabase.co

# ---------------------------------------------------------------------------
# OPTIONAL (safe defaults are used when omitted)
# ---------------------------------------------------------------------------

# Comma-separated origins allowed to call the /api. Default: Vercel frontend.
CORS_ORIGINS=https://rbac-rag-nine.vercel.app

# OpenRouter base URL (OpenAI-compatible). The rerank endpoint is derived from it.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# liquid/lfm-2.5-embedding-350m outputs 1024-dimensional vectors. This MUST match the
# `chunks.embedding vector(1024)` database column (see migrations/005_*).
OPENROUTER_EMBED_MODEL=liquid/lfm-2.5-embedding-350m:free

# Chat model (completion). Pick any model on https://openrouter.ai/models.
OPENROUTER_CHAT_MODEL=google/gemma-4-31b-it:free

# Cross-encoder rerank model used by the /rerank endpoint.
OPENROUTER_RERANK_MODEL=nvidia/llama-nemotron-rerank-vl-1b-v2:free

# Run a one-shot reranker health probe at startup (default true). Set false to skip.
RERANK_PROBE_ON_STARTUP=true

# Optional attribution headers shown in the OpenRouter dashboard.
OPENROUTER_REFERER=https://rbac-rag-nine.vercel.app
OPENROUTER_TITLE=Sentry RAG

# Max prompt size (per chunk, in characters) for the AI-role-suggestion call.
OPENROUTER_CHUNK_ROLE_BATCH_CHARS=24000

# Path to the built React SPA (only needed when serving the frontend from the
# backend, e.g. the Docker Space). Leave empty for API-only.
FRONTEND_BUILD_DIR=

# ---------------------------------------------------------------------------
# NOTES
# ---------------------------------------------------------------------------
# - No DATABASE_SSL variable is read by the code: asyncpg enables TLS
#   automatically for *.supabase.co hosts.
# - Supabase signup/login happen client-side; there is NO backend /register or
#   /login, and no JWT_SECRET / ADMIN_EMAIL / ADMIN_PASSWORD contract anymore.
