# Sentry RAG — Frontend environment
# Copy this file to `.env` before running the frontend (CRA loads .env at build time):
#   cp .env.example .env   (then fill in real values)

# ---------------------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------------------

# Supabase project URL + anon key (used by @supabase/supabase-js on the client).
REACT_APP_SUPABASE_URL=https://your-project-ref.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your_supabase_anon_key

# ---------------------------------------------------------------------------
# OPTIONAL
# ---------------------------------------------------------------------------

# Backend API origin. Empty string = same-origin (the frontend and backend are
# served from the same URL, e.g. the Hugging Face Docker Space). When the
# frontend is deployed separately (Vercel), set this to the API base, e.g.
#   REACT_APP_BACKEND_URL=https://my-space.hf.space
REACT_APP_BACKEND_URL=